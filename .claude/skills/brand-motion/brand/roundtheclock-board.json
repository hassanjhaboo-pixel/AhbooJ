{
  "name": "Round The Clock Transport",
  "tagline": "We make sure it gets there",
  "url": "@a47.detailing",
  "voice": {
    "tone": "warm, confident, dependable",
    "maxWordsPerCard": 6,
    "case": "sentence",
    "cta": "Book with us now"
  },
  "palette": {
    "bg": "#0f1113",
    "ink": "#f3efe6",
    "primary": "#f2c94c",
    "onPrimary": "#0f1113",
    "secondary": "#cf9f62",
    "onSecondary": "#0f1113",
    "accent": "#c8312a",
    "onAccent": "#f3efe6",
    "dark": "#08090a",
    "onDark": "#f3efe6",
    "chapter1": "#0f1113",
    "chapter2": "#cf9f62",
    "chapter3": "#f3efe6",
    "chapter4": "#0f1113",
    "white": "#ffffff",
    "paper": "#f3efe6",
    "kraft": "#cf9f62",
    "kraftDeep": "#a87a40",
    "kraftLight": "#e2bd8a",
    "stamp": "#c8312a",
    "tile": "#1d2024",
    "tileTop": "#24282d",
    "hinge": "#050607",
    "board": "#16191c",
    "slate": "#8f99a5",
    "goldDeep": "#c99a1f",
    "shade": "rgba(8,9,10,0.9)",
    "shadeMid": "rgba(8,9,10,0.5)",
    "clear": "rgba(8,9,10,0)",
    "inkSoft": "rgba(15,17,19,0.18)"
  },
  "type": {
    "fontUrls": [],
    "fontFiles": [
      {
        "family": "Big Shoulders",
        "weight": 800,
        "src": "assets/roundtheclock/fonts/BigShoulders-Bold.ttf"
      },
      {
        "family": "IBM Plex Mono",
        "weight": 700,
        "src": "assets/roundtheclock/fonts/IBMPlexMono-Bold.ttf"
      },
      {
        "family": "IBM Plex Mono",
        "weight": 400,
        "src": "assets/roundtheclock/fonts/IBMPlexMono-Regular.ttf"
      }
    ],
    "display": {
      "family": "Big Shoulders",
      "fallback": "'Liberation Sans', sans-serif",
      "weight": 800,
      "case": "upper",
      "tracking": 0,
      "lineHeight": 0.9
    },
    "headline": {
      "family": "IBM Plex Mono",
      "fallback": "monospace",
      "weight": 700,
      "case": "none",
      "tracking": 0,
      "lineHeight": 1.15
    },
    "body": {
      "family": "IBM Plex Mono",
      "fallback": "monospace",
      "weight": 400,
      "case": "none",
      "tracking": 0,
      "lineHeight": 1.3
    },
    "scale": {
      "display": 0.16,
      "headline": 0.09,
      "title": 0.065,
      "body": 0.042,
      "caption": 0.03
    }
  },
  "logo": {
    "src": "",
    "srcOnDark": "",
    "wordmark": "ROUND THE CLOCK",
    "color": "primary",
    "clearSpace": 0.5
  },
  "shape": {
    "language": "tiles",
    "radius": 0.006,
    "strokeW": 0.006,
    "motif": "split-flap departure board tiles, a shipping waybill with a barcode, a rubber stamp"
  },
  "motion": {
    "energy": "balanced",
    "bpm": 120,
    "exit": "inCubic",
    "move": "inOutCubic",
    "transition": "inOutCubic",
    "stagger": 0.06,
    "signatureTransition": "wipe down (a flap falling)"
  },
  "layout": {
    "safe": 0.08,
    "alignment": "center"
  },
  "rules": {
    "do": [
      "gold letters on black flap tiles for the brand voice",
      "the departure board returns on the end card",
      "phone number held on screen at least 3s"
    ],
    "dont": [
      "never show the vehicle licence plate",
      "no serif italic accents, no eyebrow badges",
      "stamp red only on paper"
    ]
  }
}