  "logo": {
    "src": "assets/area47/logo-circle.png",
    "srcOnDark": "assets/area47/logo-circle.png",
    "wordmark": "AREA 47",
    "color": "primary",
    "clearSpace": 0.3
  },
  "shape": {
    "language": "sharp",
    "radius": 0.012,
    "strokeW": 0.004,
    "motif": "sci-fi HUD: scan lines, targeting brackets, a UFO on a dashed flight path, tractor beam"
  },
  "motion": {
    "energy": "balanced",
    "bpm": 100,
    "exit": "inCubic",
    "move": "inOutCubic",
    "transition": "inOutCubic",
    "stagger": 0.05,
    "signatureTransition": "cut"
  },
  "layout": {
    "safe": 0.07,
    "alignment": "left"
  },
  "rules": {
    "do": [
      "cyan on black",
      "real photos of his work as heroes",
      "keep text inside the 3:4 grid crop"
    ],
    "dont": [
      "never show licence plates",
      "never use car-maker logos as our branding"
    ]
  }
}